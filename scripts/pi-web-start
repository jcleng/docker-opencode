#!/usr/bin/env bash
# pi-web-start: 在无 systemd 的容器里启动 Pi Coding Agent Web UI (pi-web)
# @agegr/pi-web 为单进程架构：`pi-web` 命令直接拉起 Next.js 服务器，
# 无需 sessiond / systemd，也无需 `pi-web install`。

set -uo pipefail

# pi-web 的 CLI 读取 PI_WEB_HOSTNAME / PORT，也可用 -H / -p 显式传入
PI_WEB_HOSTNAME="${PI_WEB_HOSTNAME:-127.0.0.1}"
PI_WEB_PORT="${PORT:-${PI_WEB_PORT:-8504}}"
PI_WEB_LOG_DIR="${PI_WEB_LOG_DIR:-/root/.pi-web}"
# 容器内没有默认浏览器
export PI_WEB_NO_OPEN="${PI_WEB_NO_OPEN:-1}"
# 容器内不做 npm 在线版本检查
export PI_WEB_SKIP_VERSION_CHECK="${PI_WEB_SKIP_VERSION_CHECK:-1}"

LOG="$PI_WEB_LOG_DIR/server.log"
PID_FILE="$PI_WEB_LOG_DIR/server.pid"

log() { echo "[pi-web-start] $*"; }

if ! command -v pi-web >/dev/null 2>&1; then
  log "ERROR: 未在 PATH 中找到 pi-web，请确认 @agegr/pi-web 已安装"
  exit 1
fi

mkdir -p "$PI_WEB_LOG_DIR"

is_running() {
  pgrep -f "pi-web .*--port $PI_WEB_PORT" >/dev/null 2>&1 \
    || pgrep -f "next start -p $PI_WEB_PORT" >/dev/null 2>&1
}

stop_existing() {
  log "停止已有的 pi-web 进程 ..."
  # 优先用官方命令，失败再回退到 pkill
  pi-web stop --port "$PI_WEB_PORT" >/dev/null 2>&1 || true
  pkill -f "pi-web .*--port $PI_WEB_PORT" 2>/dev/null || true
  pkill -f "next start -p $PI_WEB_PORT" 2>/dev/null || true
  for _ in $(seq 1 10); do
    is_running || break
    sleep 0.5
  done
  rm -f "$PID_FILE"
}

start_server() {
  log "启动 pi-web (监听 $PI_WEB_HOSTNAME:$PI_WEB_PORT) ..."
  nohup pi-web --hostname "$PI_WEB_HOSTNAME" --port "$PI_WEB_PORT" --no-open \
    > "$LOG" 2>&1 &
  echo "$!" > "$PID_FILE"
}

wait_ready() {
  log "等待 pi-web 就绪 ..."
  for _ in $(seq 1 60); do
    if curl -fsS -o /dev/null -m 2 "http://127.0.0.1:$PI_WEB_PORT/" 2>/dev/null; then
      log "pi-web 已就绪"
      return 0
    fi
    sleep 1
  done
  log "ERROR: 60s 内未能访问 http://127.0.0.1:$PI_WEB_PORT/ ，详见 $LOG"
  return 1
}

status() {
  if is_running; then
    log "web server: UP (pid $(cat "$PID_FILE" 2>/dev/null))"
  else
    log "web server: DOWN"
  fi
  log "Web UI   : http://$PI_WEB_HOSTNAME:$PI_WEB_PORT"
  pi-web status 2>/dev/null || true
}

case "${1:-start}" in
  start)
    if is_running; then
      log "pi-web 已在运行。"; status; exit 0
    fi
    stop_existing
    start_server
    if wait_ready; then
      status
      log "完成。如需容器外访问，请用 PI_WEB_HOSTNAME=0.0.0.0 pi-web-start restart 重启，并加反向代理鉴权"
    else
      exit 1
    fi
    ;;
  stop)
    stop_existing
    log "已停止 pi-web"
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  status)
    status
    ;;
  *)
    echo "用法: pi-web-start [start|stop|restart|status]"
    exit 1
    ;;
esac
